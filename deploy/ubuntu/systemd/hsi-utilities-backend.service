[Unit]
Description=HSI Utilities Spring Boot Backend
After=network.target

[Service]
Type=simple
User=hsiapp
Group=hsiapp
WorkingDirectory=/opt/hsi-utilities
EnvironmentFile=/etc/hsi-utilities/hsi-utilities-backend.env
ExecStart=/usr/bin/java -jar /opt/hsi-utilities/maintenance-system-0.0.1-SNAPSHOT.jar --spring.config.additional-location=file:/etc/hsi-utilities/
SuccessExitStatus=143
Restart=always
RestartSec=10
StandardOutput=append:/var/log/hsi-utilities/backend.log
StandardError=append:/var/log/hsi-utilities/backend-error.log

[Install]
WantedBy=multi-user.target
