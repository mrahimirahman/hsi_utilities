SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://10.29.59.55:3306/his_kkm?useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=utilities_app
